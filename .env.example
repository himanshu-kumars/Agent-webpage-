# ==============================================================================
# AEGIS // OPS GRID — Environment Configuration Template (.env.example)
# UNOFFICIAL FAN CONCEPT — NO GOVERNMENT AFFILIATION
# ==============================================================================

# Runtime Mode: "demo" (zero-DB deterministic memory + browser Web Crypto) or "production"
AEGIS_MODE="demo"

# Session Signing Secret (32+ bytes in production)
AEGIS_SESSION_SECRET="demo-fallback-32-byte-umbra-secret-2087"

# Session TTL in seconds (default 28800 = 8 hours)
AEGIS_SESSION_TTL_SECONDS="28800"

# Build Telemetry Tag
NEXT_PUBLIC_AEGIS_BUILD_ID="AEGIS-2087.314-OMEGA"

# Optional Production Reference Infrastructure (PostgreSQL 15+ & Redis 7+)
# DATABASE_URL="postgresql://aegis_app:REPLACE_WITH_SECRET@localhost:5432/aegis_grid"
# REDIS_URL="redis://localhost:6379/0"
# AEGIS_CONTACT_ENC_KEY="REPLACE_WITH_BASE64_32_BYTE_AES_GCM_KEY"
